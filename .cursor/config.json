{
  "project": "roguelike_rpg",
  "description": "Procedural roguelike RPG in the browser: pure TypeScript simulation, plain Three.js view, React DOM UI.",
  "stack": {
    "language": "typescript",
    "packageManager": "npm",
    "build": "vite",
    "lint": "biome",
    "renderer": "three/webgpu",
    "ui": "react-dom",
    "uiState": "zustand",
    "schemas": "zod",
    "tests": ["vitest", "playwright"],
    "hosting": "joshbosworth.com/foo (private static server)"
  },
  "paths": {
    "docs": "docs",
    "gameDesign": "docs/game_design.md",
    "techStack": "docs/techstack.md",
    "source": "src",
    "sim": "src/sim"
  }
}
