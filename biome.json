{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!!**/dist"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "overrides": [
    {
      "includes": ["src/sim/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "three": "The sim cannot import three.",
                  "react": "The sim cannot import react.",
                  "react-dom": "The sim cannot import react-dom.",
                  "zustand": "The sim cannot import zustand."
                },
                "patterns": [
                  {
                    "group": ["three/**", "react/**", "react-dom/**", "zustand/**"],
                    "message": "The sim cannot import three, react, or zustand."
                  },
                  {
                    "group": [
                      "**/view",
                      "**/view/**",
                      "**/ui",
                      "**/ui/**",
                      "**/input",
                      "**/input/**"
                    ],
                    "message": "The sim cannot import the view, UI, or input."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
